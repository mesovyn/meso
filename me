-- fuse
local function runFuse()
    local save = getSave()
    local inv = save and save.Inventory
    if type(inv) ~= "table" then return end
    local fuseLoad, fuseBegin, fuseBrief, fuseFinish
    for _, d in ipairs(RS:GetDescendants()) do
        if d:IsA("RemoteFunction") then
            if d.Name == "LoadPet" then fuseLoad = d end
            if d.Name == "BeginFuse" then fuseBegin = d end
            if d.Name == "ConfirmBriefing" then fuseBrief = d end
            if d.Name == "FinishReveal" then fuseFinish = d end
        end
    end
    if not fuseLoad or not fuseBegin then return end
    local groups = {}
    for uid, pet in pairs(inv) do
        if type(uid) == "string" and type(pet) == "table" and type(pet.Category) == "string" then
            groups[pet.Category] = groups[pet.Category] or {}
            table.insert(groups[pet.Category], uid)
        end
    end
    local chosen
    for _, uids in pairs(groups) do
        if #uids >= 3 then chosen = { uids[1], uids[2], uids[3] }; break end
    end
    if not chosen then return end
    if save.FusionLocked == true then
        if fuseFinish then pcall(function() fuseFinish:InvokeServer() end) end
        return
    end
    if save.FusionInfoAcknowledged ~= true and fuseBrief then
        pcall(function() fuseBrief:InvokeServer() end)
    end
    for _, uid in ipairs(chosen) do
        pcall(function() fuseLoad:InvokeServer(uid) end)
        task.wait(0.2)
    end
    pcall(function() fuseBegin:InvokeServer() end)
end

