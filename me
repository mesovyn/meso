local Hopping = false
local function fetchServers(cursor)
    local url = string.format(
        "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&excludeFullGames=true&limit=100",
        game.PlaceId)
    if cursor then url = url .. "&cursor=" .. cursor end
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if not ok then return nil end
    local dok, page = pcall(function() return HttpService:JSONDecode(body) end)
    if not dok or type(page) ~= "table" then return nil end
    return page
end
local function pickTargets()
    local cursor, cands = nil, {}
    for _ = 1, 4 do
        local page = fetchServers(cursor)
        if not page then break end
        for _, s in ipairs(page.data or {}) do
            if type(s) == "table" and type(s.id) == "string"
               and s.id ~= game.JobId and not Visited[s.id] then
                local p = tonumber(s.playing) or 0
                local m = tonumber(s.maxPlayers) or 0
                if m > 0 and p < m then table.insert(cands, { id=s.id, playing=p }) end
            end
        end
        cursor = page.nextPageCursor
        if not cursor or #cands >= 40 then break end
        task.wait(0.2)
    end
    table.sort(cands, function(a, b) return a.playing < b.playing end)
    return cands
end
local function serverHop()
    if Hopping then return end
    Hopping = true
    local targets = pickTargets()
    if not targets or #targets == 0 then Hopping = false; return end
    for i = 1, math.min(#targets, 8) do
        Visited[targets[i].id] = true
        local ok = pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, targets[i].id, player)
        end)
        if ok then task.wait(2) end
    end
    Hopping = false
end
