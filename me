local stealRunning = false
local function stealSpecific(uid)
    if not R.carry then return false, "no carry" end
    if not alive() or healthNow() < 80 then return false, "low hp" end
    local e = egg_state[uid]
    if not e then return false, "no record" end
    local cf = sf(e, "BottomCFrame") or sf(e, "BoundsCFrame")
    if typeof(cf) ~= "CFrame" then return false, "no cframe" end
    local area = tostring(sf(e, "AreaId") or "")
    local stand = safe_stand(cf.Position, area)
    if not stand then return false, "no safe stand" end
    swapStealHumanoid()
    local y = road_y()
    local z = road_z()
    local entry = corridor_entry()
    if currentPos().X < entry.X - 20 then hop_to(entry, 16, 0.10) end
    hop_to(Vector3.new(stand.X, y, z), 16, 0.06)
    hop_to(stand, 12, 0.15)
    if any_guard_at(currentPos(), 2) then
        hop_to(Vector3.new(stand.X - 40, y, z), 16, 0.06)
        hop_to(home_cf().Position, 18, 0.06)
        last_attempt[uid] = os.clock()
        return false, "inside guard"
    end
    local slotKey
    do
        local aId = tostring(sf(e, "AreaId") or "")
        local nId = tostring(sf(e, "NestId") or "")
        if aId ~= "" and nId ~= "" then slotKey = aId .. "/" .. nId end
    end
    STEAL_CF = CFrame.new(stand)
    STEAL_HOLD = true
    local res, err
    local deadline = os.clock() + GRAB_WINDOW
    while os.clock() < deadline do
        STEAL_CF = CFrame.new(stand)
        local r, e2 = carryEgg(uid, slotKey)
        res, err = r, e2
        if r == true or r == "Accepted" or r == "Carry" then break end
        task.wait(0.05)
    end
    STEAL_HOLD = false
    STEAL_CF = nil
    hop_to(Vector3.new(stand.X - 45, y, z), 18, 0.05)
    hop_to(home_cf().Position, 18, 0.06)
    if res ~= true and res ~= "Accepted" and res ~= "Carry" then
        last_attempt[uid] = os.clock()
    end
    return res == true or res == "Accepted" or res == "Carry", err
end
local function stealBest()
    if stealRunning then return false end
    local target = pickBest()
    if not target then return false, "no safe eggs" end
    stealRunning = true
    local ok, res = pcall(stealSpecific, target.uid)
    stealRunning = false
    return res
end

