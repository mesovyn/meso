local function inside_box(wp, model, margin)
    if not model then return false end
    local cf, size = model:GetBoundingBox()
    local lp = cf:PointToObjectSpace(wp)
    local pad = margin or GUARD_MARGIN
    local half = size * 0.5 + Vector3.new(pad, 8, pad)
    return math.abs(lp.X) <= half.X and math.abs(lp.Y) <= half.Y and math.abs(lp.Z) <= half.Z
end
local function any_guard_at(wp, margin)
    local root = guard_root()
    if not root then return false end
    for _, area in ipairs(root:GetChildren()) do
        local g = area:FindFirstChild("Guard") or area:FindFirstChild("ForestGuardAuthored")
        if g and inside_box(wp, g, margin) then return true, g, area.Name end
    end
    return false
end
local function safe_stand(egg_pos, area)
    local m = area_guard(area)
    local y = road_y()
    local tries = {
        Vector3.new(-7,0,0), Vector3.new(-9,0,0), Vector3.new(-11,0,0),
        Vector3.new(-14,0,0), Vector3.new(-18,0,0),
        Vector3.new(-6,0,-6), Vector3.new(-6,0,6),
        Vector3.new(-8,0,-8), Vector3.new(-8,0,8),
        Vector3.new(-12,0,-8), Vector3.new(0,0,-12), Vector3.new(0,0,12),
        Vector3.new(-5,0,-12),
    }
    if m then
        local gp = m:GetPivot().Position
        local away = Vector3.new(egg_pos.X - gp.X, 0, egg_pos.Z - gp.Z)
        if away.Magnitude > 0.2 then
            table.insert(tries, 1, away.Unit * 8)
            table.insert(tries, 2, away.Unit * 11 + Vector3.new(-4, 0, 0))
        end
    end
    local best, bestd
    for _, off in ipairs(tries) do
        local p = Vector3.new(egg_pos.X + off.X, y, egg_pos.Z + off.Z)
        if not inside_box(p, m, GUARD_MARGIN) and not any_guard_at(p, 3) then
            local d = (Vector3.new(p.X,0,p.Z) - Vector3.new(egg_pos.X,0,egg_pos.Z)).Magnitude
            if d <= 12 and (not bestd or d < bestd) then best, bestd = p, d end
        end
    end
    return best, bestd
end

local function hop_to(toPos, stepStuds, holdSec)
    if KILLED then return false end
    local part = hrp()
    if not part then return false end
    if typeof(toPos) == "CFrame" then toPos = toPos.Position end
    local y = road_y()
    local zRoad = road_z()
    toPos = Vector3.new(toPos.X, y, toPos.Z)
    stepStuds = stepStuds or STEP_STUDS
    swapStealHumanoid()
    local deadline = os.clock() + HOP_TIMEOUT
    while (part.Position - toPos).Magnitude > 3.1 do
        if KILLED or os.clock() > deadline then break end
        if healthNow() < 40 then return false end
        local delta = toPos - part.Position
        local nextPos = part.Position + delta.Unit * math.min(stepStuds, delta.Magnitude)
        nextPos = Vector3.new(nextPos.X, y, nextPos.Z)
        if any_guard_at(nextPos, 3) then
            local slide = Vector3.new(nextPos.X, y, zRoad)
            if (slide - part.Position).Magnitude > 1 then
                nextPos = part.Position
                    + (slide - part.Position).Unit * math.min(stepStuds, (slide - part.Position).Magnitude)
                nextPos = Vector3.new(nextPos.X, y, nextPos.Z)
            end
            if any_guard_at(nextPos, 3) then
                nextPos = Vector3.new(part.Position.X - 12, y, zRoad)
            end
        end
        local cf = CFrame.new(nextPos)
        local t1 = os.clock()
        while os.clock() - t1 < STEP_HOLD and not KILLED do
            if part.Parent then
                part.CFrame = cf
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end
            task.wait()
        end
        part = hrp()
        if not part then return false end
    end
    local dest = CFrame.new(toPos)
    local t1 = os.clock()
    while os.clock() - t1 < (holdSec or 0.15) and not KILLED do
        part = hrp()
        if not part then return false end
        part.CFrame = dest
        part.AssemblyLinearVelocity = Vector3.zero
        part.AssemblyAngularVelocity = Vector3.zero
        task.wait()
    end
    return true
end

