local function pull_snapshot()
    if not R.fieldSnap then return end
    local ok, snap = pcall(function() return R.fieldSnap:InvokeServer() end)
    if not ok or type(snap) ~= "table" then return end
    local records = snap.Records or snap
    for uid, rec in pairs(records) do
        if type(rec) == "table" then
            local copy = {}
            for k, v in pairs(rec) do copy[k] = v end
            if copy.Uid == nil then copy.Uid = uid end
            merge_record(copy)
        end
    end
    state_dirty = true
end

