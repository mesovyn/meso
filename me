local function sf(t, k)
    if type(t) ~= "table" then return nil end
    local ok, v = pcall(function() return t[k] end)
    if ok then return v end
    local ok2, v2 = pcall(rawget, t, k)
    if ok2 then return v2 end
    return nil
end
local function fmt_money(n)
    n = tonumber(n) or 0
    if n >= 1e12 then return string.format("%.2fT", n/1e12) end
    if n >= 1e9 then return string.format("%.2fB", n/1e9) end
    if n >= 1e6 then return string.format("%.2fM", n/1e6) end
    if n >= 1e3 then return string.format("%.2fK", n/1e3) end
    return string.format("%.0f", n)
end
local function fmt_weight(kg)
    kg = tonumber(kg) or 0
    if kg >= 1000 then return string.format("%.1fT", kg/1000) end
    return string.format("%.1fKg", kg)
end
local function hex(c)
    return string.format("#%02X%02X%02X", math.floor(c.R*255), math.floor(c.G*255), math.floor(c.B*255))
end
local function mutation_multiplier(e)
    local m = 1.0
    local base = sf(e, "BaseMutation")
    if type(base) == "string" then m *= MUT_MULT[base] or 1.0 end
    local muts = sf(e, "Mutations")
    if type(muts) == "table" then
        for _, mu in pairs(muts) do
            local name = type(mu) == "string" and mu or (type(mu) == "table" and (sf(mu,"Name") or sf(mu,"Id")))
            if name then m *= MUT_MULT[name] or 1.0 end
        end
    end
    if sf(e, "HasParasite") == true then m *= PARASITE_MULT end
    return m
end
local function lookup_pet(e) return PET[tostring(sf(e, "AssetCategory") or "")] end
local function egg_stats(e)
    local info = lookup_pet(e)
    local scale = tonumber(sf(e, "AssetScale")) or 1.0
    if info then return info.tier, info.income, info.weight * scale, info.icon end
    local tier = "Common"
    if scale >= 3.0 then tier = "Divine"
    elseif scale >= 2.0 then tier = "Mythic"
    elseif scale >= 1.5 then tier = "Legendary"
    elseif scale >= 1.2 then tier = "Epic"
    elseif scale >= 1.0 then tier = "Rare" end
    return tier, 100, scale * 10, ""
end
local function egg_income(e)
    local _, base = egg_stats(e)
    return base * mutation_multiplier(e)
end
local function tier_rank(name)
    for i, t in ipairs(TIER_ORDER) do if t == name then return i end end
    return 0
end

