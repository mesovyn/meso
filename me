local function mutationBonus(rec)
    local blob = tostring(sf(rec, "BaseMutation") or "")
    local muts = sf(rec, "Mutations")
    if type(muts) == "table" then
        for _, m in pairs(muts) do blob = blob .. "," .. tostring(m) end
    end
    local s = blob:lower()
    if s:find("rainbow",1,true) then return 50000000 end
    if s:find("gold",1,true) then return 30000000 end
    if s:find("silver",1,true) then return 10000000 end
    if s ~= "" then return 2000000 end
    return 0
end
local function filterAllows(e)
    local tier = egg_stats(e)
    local animal = tostring(sf(e, "AssetCategory") or "")
    local area = tostring(sf(e, "AreaId") or "")
    local mut = tostring(sf(e, "BaseMutation") or "None")
    if STATE.filterRarity ~= "All" and STATE.filterRarity ~= tier then return false end
    if STATE.filterArea ~= "All" and STATE.filterArea ~= area then return false end
    if STATE.filterName ~= "All" and STATE.filterName ~= animal then return false end
    if STATE.filterMutation ~= "All" and STATE.filterMutation ~= mut then return false end
    return true
end
local function pickBest()
    local nowt = os.clock()
    local best
    for uid, e in pairs(egg_state) do
        if tostring(sf(e, "State") or "Slot") == "Slot" then
            local cf = sf(e, "BottomCFrame") or sf(e, "BoundsCFrame")
            if typeof(cf) == "CFrame" then
                local uidStr = tostring(uid)
                local skipAt = last_attempt[uidStr]
                local notMine = not uidStr:find(tostring(USER_ID), 1, true)
                if notMine and filterAllows(e)
                   and not (skipAt and (nowt - skipAt) < PER_EGG_COOLDOWN) then
                    local area = tostring(sf(e, "AreaId") or "")
                    local cat = tostring(sf(e, "AssetCategory") or "")
                    local tier = egg_stats(e)
                    local stand, standDist = safe_stand(cf.Position, area)
                    if stand then
                        local rarN, rarName, earn = assetRarityOf(cat)
                        local score = rarN * 1000000000 + mutationBonus(e) + earn + (AREA_RANK[area] or 0)
                        if not best or score > best.score then
                            local mut = tostring(sf(e, "BaseMutation") or "")
                            best = {
                                uid=uidStr, area=area, tier=tier,
                                pos=cf.Position, stand=stand, standDist=standDist,
                                score=score, rarity=rarName,
                                label=string.format("%s %s%s %s", cat, tier,
                                    mut ~= "" and (" " .. mut) or "", area),
                            }
                        end
                    end
                end
            end
        end
    end
    return best
end

