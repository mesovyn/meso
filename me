local function withinEspRange(pos)
    if not rootPart then return false end
    return (rootPart.Position - pos).Magnitude <= STATE.espRange
end
local function ensureEsp(id, color)
    if espEntries[id] then return espEntries[id] end
    local anchor = Instance.new("Part")
    anchor.Name = "EspAnchor"; anchor.Anchored = true; anchor.CanCollide = false
    anchor.CanQuery = false; anchor.CanTouch = false; anchor.Transparency = 1
    anchor.Size = Vector3.new(0.2, 0.2, 0.2); anchor.Parent = espFolder
    local bb = Instance.new("BillboardGui")
    bb.AlwaysOnTop = true; bb.Size = UDim2.fromOffset(220, 34)
    bb.StudsOffset = Vector3.new(0, 2.5, 0); bb.Adornee = anchor; bb.Parent = anchor
    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1; lbl.Size = UDim2.fromScale(1, 1)
    lbl.Font = Enum.Font.GothamBold; lbl.TextSize = 13
    lbl.TextStrokeTransparency = 0.4; lbl.TextColor3 = color; lbl.Parent = bb
    espEntries[id] = { anchor = anchor, bb = bb, lbl = lbl }
    return espEntries[id]
end
local function drawEsp(id, pos, txt, color)
    local e = ensureEsp(id, color)
    e.anchor.CFrame = CFrame.new(pos)
    e.lbl.Text = txt
    e.lbl.TextColor3 = color
    espSeen[id] = true
end
local function releaseEsp(id)
    local e = espEntries[id]; if not e then return end
    if e.bb then e.bb:Destroy() end
    if e.anchor then e.anchor:Destroy() end
    espEntries[id] = nil
end
local function clearEsp()
    for id in pairs(espEntries) do releaseEsp(id) end
end
local function runEsp()
    table.clear(espSeen)
    if STATE.espWorldEggs or STATE.espCarriedEggs then
        for uid, e in pairs(egg_state) do
            local cf = sf(e, "BottomCFrame") or sf(e, "BoundsCFrame")
            local st = tostring(sf(e, "State") or "Slot")
            local show = (st == "Slot" and STATE.espWorldEggs)
                      or ((st == "Dropped" or st == "Carried") and STATE.espCarriedEggs)
            if show and typeof(cf) == "CFrame" and withinEspRange(cf.Position) then
                local tier = egg_stats(e)
                local col = TIER_COLORS[tier] or STROKE
                drawEsp("egg_"..uid, cf.Position,
                    string.format("%s [%s]", tostring(sf(e, "AssetCategory") or "?"), tier),
                    col)
            end
        end
    end
    if STATE.espGuards then
        local areas = workspace:FindFirstChild("__OBJECTS")
        areas = areas and areas:FindFirstChild("Areas")
        local guardRoot = areas and areas:FindFirstChild("GuardAreas")
        if guardRoot then
            for _, area in ipairs(guardRoot:GetChildren()) do
                local g = area:FindFirstChild("Guard") or area:FindFirstChild("ForestGuardAuthored")
                if g then
                    local ok, pivot = pcall(function() return g:GetPivot() end)
                    if ok and pivot and withinEspRange(pivot.Position) then
                        drawEsp("guard_"..area.Name, pivot.Position, "Guard "..area.Name,
                            Color3.fromRGB(255,140,90))
                    end
                end
            end
        end
    end
    if STATE.espPlayers then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player then
                local char = p.Character
                local rp = char and char:FindFirstChild("HumanoidRootPart")
                if rp and withinEspRange(rp.Position) then
                    drawEsp("player_"..p.Name, rp.Position, p.DisplayName,
                        Color3.fromRGB(120,190,255))
                end
            end
        end
    end
    for id in pairs(espEntries) do
        if not espSeen[id] then releaseEsp(id) end
    end
end

-- server hop
local Visited = (getgenv and getgenv().MesoHopHistory) or {}
if getgenv then getgenv().MesoHopHistory = Visited end
Visited[tostring(game.JobId)] = true
local Hopping = false
local function serverHop()
    if Hopping then return end
    Hopping = true
    local url = string.format(
        "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&excludeFullGames=true&limit=100",
        game.PlaceId)
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if not ok then Hopping = false; return end
    local dok, page = pcall(function() return game:GetService("HttpService"):JSONDecode(body) end)
    if not dok or type(page) ~= "table" then Hopping = false; return end
    local targets = {}
    for _, s in ipairs(page.data or {}) do
        if type(s) == "table" and type(s.id) == "string" and s.id ~= game.JobId and not Visited[s.id] then
            local p = tonumber(s.playing) or 0
            local m = tonumber(s.maxPlayers) or 0
            if m > 0 and p < m then targets[#targets+1] = { id = s.id, playing = p } end
        end
    end
    table.sort(targets, function(a,b) return a.playing < b.playing end)
    for i = 1, math.min(#targets, 6) do
        Visited[targets[i].id] = true
        local tp = pcall(function()
            game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, targets[i].id, player)
        end)
        if tp then task.wait(2) end
    end
    Hopping = false
end

