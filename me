    return rarity._id or rarity.DisplayName
end

-- place
local function getUnplacedEggs()
    local save = getSave()
    local inv = save and save.EggInventory
    local out = {}
    if type(inv) ~= "table" then return out end
    for uid, egg in pairs(inv) do
        if type(uid) == "string" and type(egg) == "table" and egg.Placement == nil then
            out[#out+1] = uid
        end
    end
    return out
end
local function getPlacementCFs()
    if not PlotApi.GetPlotData then return {} end
    local plot = PlotApi.GetPlotData()
    if not plot or not plot.PetArea or not plot.CenterPoint then return {} end
    local petArea = plot.PetArea
    local centerPoint = plot.CenterPoint
    local size = petArea.Size
    local list = {}
    for x = -size.X * 0.5 + 5, size.X * 0.5 - 5, 7 do
        for z = -size.Z * 0.5 + 5, size.Z * 0.5 - 5, 7 do
            local world = petArea.CFrame:PointToWorldSpace(Vector3.new(x, 1, z))
            table.insert(list, centerPoint.CFrame:ToObjectSpace(CFrame.new(world)))
        end
    end
    return list
end
local function runPlace()
    if not EggApi.RequestPlaceEgg then return end
    local unplaced = getUnplacedEggs()
    if #unplaced == 0 then return end
    local place = getPlacementCFs()
    if #place == 0 then return end
    for _, uid in ipairs(unplaced) do
        if EggApi.RequestEquipTool then pcall(EggApi.RequestEquipTool, uid) end
        task.wait(0.15)
        local placed = false
        for _, cf in ipairs(place) do
            local ok = pcall(function()
                return EggApi.RequestPlaceEgg(uid, cf) == true
            end)
            if ok then placed = true; task.wait(0.25); break end
        end
        if not placed then break end
    end
end

