local minimized = false
local function restore()
    if not minimized then return end
    minimized = false
    main.Visible = true
    main.GroupTransparency = 1
    main.Size = UDim2.new(0, 0, 0, 0)
    bubble.Visible = false
    TweenService:Create(main, TweenInfo.new(0.3, Enum.EasingStyle.Back), {
        GroupTransparency = 0, Size = UDim2.new(0, W, 0, H),
    }):Play()
end
local function minimize()
    if minimized then return end
    minimized = true
    local out = TweenService:Create(main, TweenInfo.new(0.22, Enum.EasingStyle.Quad), {
        GroupTransparency = 1, Size = UDim2.new(0, 0, 0, 0),
    })
    out:Play()
    out.Completed:Wait()
    main.Visible = false
    bubble.Visible = true
    bubble.GroupTransparency = 1
    bubble.Size = UDim2.new(0, 0, 0, 0)
    TweenService:Create(bubble, TweenInfo.new(0.3, Enum.EasingStyle.Back), {
        GroupTransparency = 0, Size = UDim2.new(0, 46, 0, 46),
    }):Play()
end
