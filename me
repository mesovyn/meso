local function releaseEsp(id)
    local e = EspEntries[id]; if not e then return end
    if e.bb then e.bb:Destroy() end
    if e.anchor then e.anchor:Destroy() end
    EspEntries[id] = nil
end
local function clearEsp()
    for id in pairs(EspEntries) do releaseEsp(id) end
end
local function runEsp()
    table.clear(EspSeen)
    if STATE.espWorldEggs or STATE.espCarriedEggs then
        for uid, e in pairs(egg_state) do
            local cf = sf(e, "BottomCFrame") or sf(e, "BoundsCFrame")
            local state = tostring(sf(e, "State") or "Slot")
            local show = (state == "Slot" and STATE.espWorldEggs)
                      or ((state == "Dropped" or state == "Carried") and STATE.espCarriedEggs)
            if show and typeof(cf) == "CFrame" and withinRange(cf.Position) then
                local rarity = assetRarityOf(tostring(sf(e, "AssetCategory") or ""))
                drawEsp("egg_"..uid, cf.Position,
                    string.format("%s [%s]", tostring(sf(e, "AssetCategory") or "?"), tostring(rarity)),
                    espColor(tostring(rarity)))
            end
        end
    end
    if STATE.espGuards then
        local root = guard_root()
        if root then
            for _, area in ipairs(root:GetChildren()) do
                local g = area:FindFirstChild("Guard") or area:FindFirstChild("ForestGuardAuthored")
                if g then
                    local ok, pivot = pcall(function() return g:GetPivot() end)
                    if ok and pivot and withinRange(pivot.Position) then
                        drawEsp("guard_"..area.Name, pivot.Position, "Guard "..area.Name,
                            Color3.fromRGB(255,140,90))
                    end
                end
            end
        end
    end
    if STATE.espPlayers then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player then
                local char = p.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root and withinRange(root.Position) then
                    drawEsp("player_"..p.Name, root.Position, p.DisplayName,
                        Color3.fromRGB(120,190,255))
                end
            end
        end
    end
    for id in pairs(EspEntries) do
        if not EspSeen[id] then releaseEsp(id) end
    end
end

