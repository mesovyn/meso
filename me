UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
    and input.UserInputType ~= Enum.UserInputType.Touch then return end
    if dragging then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            dragOrigin.X.Scale, dragOrigin.X.Offset + delta.X,
            dragOrigin.Y.Scale, dragOrigin.Y.Offset + delta.Y)
    end
    if bDragging then
        local delta = input.Position - bStart
        if math.abs(delta.X) > 3 or math.abs(delta.Y) > 3 then bMoved = true end
        bubble.Position = UDim2.new(
            bOrigin.X.Scale, bOrigin.X.Offset + delta.X,
            bOrigin.Y.Scale, bOrigin.Y.Offset + delta.Y)
    end
    if eDragging then
        local delta = input.Position - eStart
        eggMain.Position = UDim2.new(
            eOrigin.X.Scale, eOrigin.X.Offset + delta.X,
            eOrigin.Y.Scale, eOrigin.Y.Offset + delta.Y)
    end
end)

local minimized = false
local eggWasVisible = false
function restore()
    if not minimized then return end
    minimized = false
    local bp = bubble.AbsolutePosition
    main.Position = UDim2.new(0, bp.X + W / 2, 0, bp.Y + H / 2)
    bubble.Visible = false
    main.Visible = true
    main.GroupTransparency = 1
    main.Size = UDim2.new(0, 0, 0, 0)
    TweenService:Create(main, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        GroupTransparency = 0, Size = UDim2.new(0, W, 0, H)
    }):Play()
    if eggWasVisible then eggGui.Enabled = true; eggWasVisible = false end
end
local function minimize()
    if minimized then return end
    if activeClose then activeClose() end
    minimized = true
    eggWasVisible = eggGui.Enabled
    eggGui.Enabled = false
    local bp = main.AbsolutePosition
    bubble.Position = UDim2.new(0, bp.X, 0, bp.Y)
    local out = TweenService:Create(main, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        GroupTransparency = 1, Size = UDim2.new(0, 0, 0, 0)
    })
    out:Play()
    out.Completed:Wait()
    main.Visible = false
    bubble.Visible = true
    bubble.GroupTransparency = 1
    bubble.Size = UDim2.new(0, 0, 0, 0)
    TweenService:Create(bubble, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        GroupTransparency = 0, Size = UDim2.new(0, 46, 0, 46)
    }):Play()
end
