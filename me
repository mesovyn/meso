local function merge_record(rec)
    if type(rec) ~= "table" then return end
    local uid = sf(rec, "Uid"); if type(uid) ~= "string" then return end
    local cur = egg_state[uid] or {}
    local prev_state = cur.State
    for _, k in ipairs({
        "AssetCategory","AreaId","AssetScale","NestScale","NestId",
        "AssetColorIndex","AssetColorSeed","AssetEyeColor",
        "BaseMutation","HasParasite","GrowthSpeedMultiplier",
        "BottomCFrame","BoundsCFrame","BoundsSize","Version",
        "State","CarrierUserId","DroppedAt",
    }) do
        local v = sf(rec, k); if v ~= nil then cur[k] = v end
    end
    local muts = sf(rec, "Mutations")
    if type(muts) == "table" then cur.Mutations = muts end
    if prev_state ~= cur.State then state_dirty = true end
    egg_state[uid] = cur
end

local hooked = {}
local function hook_re(rem)
    if hooked[rem] or not rem:IsA("RemoteEvent") then return end
    hooked[rem] = true
    rem.OnClientEvent:Connect(function(...)
        for _, a in ipairs({...}) do
            if type(a) == "table" then
                local records = sf(a, "Records")
                if type(records) == "table" then
                    for uid_key, r in pairs(records) do
                        if type(r) == "table" then
                            local copy = {}
                            for k, v in pairs(r) do copy[k] = v end
                            if copy.Uid == nil and type(uid_key) == "string" then copy.Uid = uid_key end
                            merge_record(copy)
                        end
                    end
                end
                if sf(a, "Uid") then merge_record(a) end
            end
        end
    end)
end
local function hookAllRemotes()
    local roots = { RS, workspace, player:FindFirstChild("PlayerScripts") }
    local function walk(node, depth)
        if not node or depth > 8 then return end
        local ok, children = pcall(function() return node:GetChildren() end)
        if not ok or not children then return end
        for _, c in ipairs(children) do
            if c:IsA("RemoteEvent") then hook_re(c)
            elseif c:IsA("Folder") or c:IsA("Model") then walk(c, depth + 1) end
        end
    end
    for _, r in ipairs(roots) do if r then walk(r, 0) end end
end
hookAllRemotes()
task.spawn(function() while true do task.wait(5); hookAllRemotes() end end)

local function pull_snapshot()
    if EggApi.GetAreaEggSnapshot then
        local ok, snap = pcall(EggApi.GetAreaEggSnapshot)
        if ok and type(snap) == "table" then
            local records = snap.Records or snap
            for uid, rec in pairs(records) do
                if type(rec) == "table" then
                    local copy = {}
                    for k, v in pairs(rec) do copy[k] = v end
                    if copy.Uid == nil then copy.Uid = uid end
                    merge_record(copy)
                end
            end
            state_dirty = true
            return
        end
    end
    -- fallback: scan workspace slots
    local folder = workspace:FindFirstChild("AreaEggSlotsClient")
    if folder then
        for _, slot in ipairs(folder:GetChildren()) do
            local rec = slot:GetAttribute("Record")
            if type(rec) == "table" then merge_record(rec) end
        end
        state_dirty = true
    end
end

-- ═══════════ ANTI-PUSH-BACK + HUMAN SWAP (from BobloUI — this is the fix) ═══════════
local function swapStealHumanoid()
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    if hum:GetAttribute("MesoStealHum") == true then return true end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("LocalScript") and string.find(d.Name, "PushBack", 1, true) then
            pcall(function() d.Disabled = true; d:Destroy() end)
        end
    end
    hum.Archivable = true
    local clone = hum:Clone()
    if not clone then return false end
    clone:SetAttribute("MesoStealHum", true)
    clone.Sit = false; clone.PlatformStand = false; clone.AutoRotate = true
    hum:Destroy()
    clone.Parent = char
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    pcall(function() clone:ChangeState(Enum.HumanoidStateType.Running) end)
    return true
end

