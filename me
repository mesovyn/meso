local function merge_record(rec)
    if type(rec) ~= "table" then return end
    local uid = sf(rec, "Uid"); if type(uid) ~= "string" then return end
    local cur = egg_state[uid] or {}
    local prev_state = cur.State
    for _, k in ipairs({
        "AssetCategory","AreaId","AssetScale","NestScale","NestId",
        "BaseMutation","HasParasite","GrowthSpeedMultiplier",
        "BottomCFrame","BoundsCFrame","BoundsSize","Version",
        "State","CarrierUserId",
    }) do
        local v = sf(rec, k); if v ~= nil then cur[k] = v end
    end
    local muts = sf(rec, "Mutations")
    if type(muts) == "table" then cur.Mutations = muts end
    if prev_state ~= cur.State then state_dirty = true end
    egg_state[uid] = cur
end

local hooked = {}
local function hook_re(rem)
    if hooked[rem] or not rem:IsA("RemoteEvent") then return end
    hooked[rem] = true
    rem.OnClientEvent:Connect(function(...)
        for _, a in ipairs({...}) do
            if type(a) == "table" then
                local records = sf(a, "Records")
                if type(records) == "table" then
                    for uid_key, r in pairs(records) do
                        if type(r) == "table" then
                            local copy = {}
                            for k, v in pairs(r) do copy[k] = v end
                            if copy.Uid == nil and type(uid_key) == "string" then copy.Uid = uid_key end
                            merge_record(copy)
                        end
                    end
                end
                if sf(a, "Uid") then merge_record(a) end
            end
        end
    end)
end
local function hook_all_remotes()
    if not Networking then return end
    for _, c in ipairs(Networking:GetChildren()) do
        if c:IsA("RemoteEvent") then hook_re(c) end
    end
end
