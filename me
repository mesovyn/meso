local function occupied_slots()
    local used, plot = {}, plot_folder()
    if not plot then return used end
    for uid in pairs(saveData().EggInventory or {}) do
        local rec = eggRecord(uid)
        if rec and rec.Placement and typeof(rec.Placement.LocalCFrame) == "CFrame" then
            local w = plot:GetPivot():ToWorldSpace(rec.Placement.LocalCFrame)
            table.insert(used, w.Position)
