local function renderEggList()
    local rows = {}
    for uid, e in pairs(egg_state) do
        local st = tostring(sf(e, "State") or "Slot")
        if st == "Slot" then
            local tier, _, kg = egg_stats(e)
            if eggActiveFilter == "All" or eggActiveFilter == tier then
                rows[#rows+1] = {
                    uid=uid, tier=tier,
                    animal=tostring(sf(e, "AssetCategory") or "?"),
                    biome=tostring(sf(e, "AreaId") or "?"),
                    weight=kg,
                    income=egg_income(e),
                }
            end
        end
    end
    if eggSort == "value" then
        table.sort(rows, function(a, b) return a.income > b.income end)
    else
        table.sort(rows, function(a, b)
            local ra, rb = TIER_RANK[a.tier] or 0, TIER_RANK[b.tier] or 0
            if ra ~= rb then return ra > rb end
            return a.income > b.income
        end)
    end
    while #eggCardPool < #rows do
        eggCardPool[#eggCardPool+1] = buildEggCard(#eggCardPool + 1)
    end
    for i = 1, #eggCardPool do
        eggCardPool[i].frame.Visible = (i <= #rows)
    end
    for i, r in ipairs(rows) do
        local c = eggCardPool[i]
        c.store.uid = r.uid
        c.name.Text = r.animal
        local tierCol  = TIER_COLORS[r.tier] or STROKE
        local biomeCol = BIOME_COLORS[r.biome] or BIOME_COLORS.Default
        c.sub.Text = string.format(
            '<font color="%s">%s</font> · <font color="%s">%s</font> · %s',
            hex(tierCol), r.tier, hex(biomeCol), r.biome, fmt_weight(r.weight))
        c.income.Text = fmt_money(r.income) .. "/s"
        c.strip.BackgroundColor3 = biomeCol
        c.check.BackgroundColor3 = selected[r.uid] and ACCENT or BG
    end
    eggList.CanvasSize = UDim2.new(0, 0, 0, #rows * 66 + 8)
    eggCount.Text = string.format("%d eggs", #rows)
end

