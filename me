local autoRunning = false
local function autoLoop()
    if autoRunning then return end
    autoRunning = true
    task.spawn(function()
        local last_shop = 0
        local last_hop_check = 0
        local no_egg_since = 0
        local session_start = os.clock()
        while not KILLED do
            local night = isNight()
            if night then
                if STATE.autoPlant or STATE.autoHatch or STATE.autoEquipBest then
                    pcall(plotPulse)
                end
                if STATE.autoTreadmill then pcall(runTreadmill) end
            else
                if os.clock() - last_shop > 10 then
                    if STATE.autoBuyTrail then pcall(buyBestTrail) end
                    if STATE.autoEquipBestTrail then pcall(wearBestTrail) end
                    if STATE.autoUpgrades then pcall(raiseBase); pcall(raiseTreadmill) end
                    if STATE.autoEquipBest and equipBestPets then pcall(equipBestPets) end
                    last_shop = os.clock()
                end
                if STATE.autoSteal and not stealRunning then
                    pcall(stealBest)
                end
                if STATE.autoServerHop and os.clock() - last_hop_check > 3 then
                    last_hop_check = os.clock()
                    if STATE.hopMode == "No Matching Eggs" then
                        local t = pickBest()
                        if not t then
                            if no_egg_since == 0 then no_egg_since = os.clock() end
                            if os.clock() - no_egg_since >= STATE.hopValue then
                                no_egg_since = 0
                                task.spawn(serverHop)
                            end
                        else
                            no_egg_since = 0
                        end
                    end
                end
            end
            if STATE.autoFuse and os.clock() - last_shop > 8 then pcall(runFuse) end
            if STATE.autoSellPets and os.clock() - last_shop > 6 then pcall(runSellPets) end
            if STATE.webhookEnabled and os.clock() - session_start >= WebhookCfg.interval * 60 then
                session_start = os.clock()
                pcall(sendSummary)
            end
            task.wait(AUTO_TICK)
        end
        autoRunning = false
    end)
end
autoLoop()

