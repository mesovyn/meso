local function try_require(path)
    local ok, mod = pcall(function()
        local node = RS
        for part in string.gmatch(path, "[^/]+") do
            node = node:FindFirstChild(part)
            if not node then error("missing " .. part) end
        end
        return require(node)
    end)
    return ok and mod or nil
end
