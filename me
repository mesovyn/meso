-- ═══════════ GLIDE ENGINE ═══════════
local autopilot_target = nil
local movementKeys = {W=false, A=false, S=false, D=false, Space=false, LeftShift=false}

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    local key = input.KeyCode.Name
    if movementKeys[key] ~= nil then movementKeys[key] = true end
end)
UserInputService.InputEnded:Connect(function(input)
    local key = input.KeyCode.Name
    if movementKeys[key] ~= nil then movementKeys[key] = false end
end)

RunService.Heartbeat:Connect(function(dt)
    if not dragPart or not dragPart.Parent or not character or not humanoid
       or humanoid.Health <= 0 or not rootPart or not rootPart.Parent then return end
    humanoid:ChangeState(Enum.HumanoidStateType.Running)
    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    local moveDirection = Vector3.new(0, 0, 0)
    if autopilot_target then
        local delta = autopilot_target - rootPart.Position
        if delta.Magnitude < ARRIVE_RADIUS then autopilot_target = nil
        else moveDirection = delta.Unit end
    end
    if moveDirection.Magnitude < 0.01 then
        if movementKeys.W then moveDirection = moveDirection + camera.CFrame.LookVector end
        if movementKeys.S then moveDirection = moveDirection - camera.CFrame.LookVector end
        if movementKeys.D then moveDirection = moveDirection + camera.CFrame.RightVector end
        if movementKeys.A then moveDirection = moveDirection - camera.CFrame.RightVector end
        if movementKeys.Space then moveDirection = moveDirection + Vector3.new(0,1,0) end
        if movementKeys.LeftShift then moveDirection = moveDirection - Vector3.new(0,1,0) end
    end
    if moveDirection.Magnitude > 0 then
        moveDirection = moveDirection.Unit
        local nextPosition = dragPart.Position + (moveDirection * GLIDE_SPEED * dt)
        dragPart.CFrame = CFrame.new(nextPosition, nextPosition + camera.CFrame.LookVector)
    else
        dragPart.CFrame = CFrame.new(rootPart.Position, rootPart.Position + camera.CFrame.LookVector * Vector3.new(1,0,1))
    end
end)

local function flyRoute(route, leg_timeout)
    leg_timeout = leg_timeout or 90
    for _, target in ipairs(route) do
        autopilot_target = target
        local t0 = tick()
        while autopilot_target and (tick() - t0) < leg_timeout do
            if not rootPart or not rootPart.Parent then break end
            task.wait()
        end
        autopilot_target = nil
        task.wait(0.08)
    end
    autopilot_target = nil
end

-- ═══════════ STEAL PIPELINE ═══════════
local function get_steal_prompts()
    local root = workspace:FindFirstChild("SmartPromptPart")
    if not root then return {} end
    local out = {}
    for _, child in ipairs(root:GetChildren()) do
        if child:IsA("ProximityPrompt") then
            local at = (child.ActionText or ""):lower()
            if at:find("steal") or at:find("egg") then out[#out+1] = child end
        end
    end
    return out
end

local function try_pickup()
    local t0 = tick()
    while tick() - t0 < 2.0 do
        local prompts = get_steal_prompts()
        if #prompts > 0 then
            local chosen
            for _, p in ipairs(prompts) do if p.Enabled then chosen = p; break end end
            if not chosen then
                chosen = prompts[1]
                pcall(function() chosen.Enabled = true end)
            end
            if chosen then
                local hold = tonumber(chosen.HoldDuration) or 1.2
                local hold_time = math.max(hold + 0.2, EGG_PROMPT_HOLD)
                local hb = pcall(function() chosen:InputHoldBegin() end)
                local kd = pcall(function()
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                end)
                if fireproximityprompt then pcall(function() fireproximityprompt(chosen) end) end
                task.wait(hold_time)
                if hb then pcall(function() chosen:InputHoldEnd() end) end
                if kd then
                    pcall(function()
                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                    end)
                end
                return true
            end
        end
        task.wait(0.08)
    end
    return false
end

-- THE FIX: use the game's own client module, with slotKey when the uid is first-area
local carry_remotes = {}
do
    local function walk(node, depth)
        if not node or depth > 8 then return end
        local ok, children = pcall(function() return node:GetChildren() end)
        if not ok or not children then return end
        for _, c in ipairs(children) do
            if c:IsA("RemoteFunction") or c:IsA("RemoteEvent") then
                local ln = c.Name:lower()
                if ln:find("carry") or ln:find("askfieldegg") then
                    carry_remotes[#carry_remotes+1] = c
                end
            end
            if c:IsA("Folder") then walk(c, depth + 1) end
        end
    end
    walk(RS, 0)
end

local function tryCarryEgg(uid)
    -- preferred: the game's own client module
    if EggApi.RequestCarryAreaEgg then
        local slotKey = nil
        local rec = egg_state[uid]
        if SlotApi.IsFirstAreaUid and SlotApi.IsFirstAreaUid(uid) and SlotApi.BuildSlotKey and rec then
            local area = tostring(sf(rec, "AreaId") or "")
            local nest = tostring(sf(rec, "NestId") or "")
            slotKey = SlotApi.BuildSlotKey(area, nest)
        end
        local ok, carried = pcall(EggApi.RequestCarryAreaEgg, uid, slotKey)
        if ok and carried == true then return true end
    end
    -- fallback: fire remotes directly with both arg shapes
    local rec = egg_state[uid]
    local nest = rec and tostring(sf(rec, "NestId") or "") or ""
    local area = rec and tostring(sf(rec, "AreaId") or "") or ""
    for _, rem in ipairs(carry_remotes) do
        if rem:IsA("RemoteFunction") then
            pcall(function() rem:InvokeServer(uid, nil) end)
            pcall(function() rem:InvokeServer(uid, nest) end)
            pcall(function() rem:InvokeServer(uid, area .. "/" .. nest) end)
        elseif rem:IsA("RemoteEvent") then
            pcall(function() rem:FireServer(uid, nil) end)
            pcall(function() rem:FireServer(uid, nest) end)
            pcall(function() rem:FireServer(uid, area .. "/" .. nest) end)
        end
    end
    return false
end

local function steal_egg(uid)
    local e = egg_state[uid]
    if not e then return false end
    local now = tick()
    if last_attempt[uid] and (now - last_attempt[uid]) < PER_EGG_COOLDOWN then return false end
    last_attempt[uid] = now

    local cf = sf(e, "BottomCFrame") or sf(e, "BoundsCFrame")
    if typeof(cf) ~= "CFrame" then return false end

    -- kill push-back BEFORE we fly
    swapStealHumanoid()

    local egg_target = Vector3.new(cf.Position.X, cf.Position.Y + 2, cf.Position.Z)
    flyRoute({ START_POS, egg_target }, 60)
    task.wait(math.random(300, 550) / 1000)

    -- try both prompt and remote
    try_pickup()
    tryCarryEgg(uid)
    task.wait(math.random(700, 1100) / 1000)
    -- second attempt in case first was rejected
    tryCarryEgg(uid)
    task.wait(0.3)

    for _ = 1, 3 do
        flyRoute({ START_POS }, 60)
        if (rootPart.Position - START_POS).Magnitude < 12 then break end
        task.wait(0.3)
    end
    task.wait(math.random(400, 800) / 1000)
    return true
end

local function buildEligibleList()
    local uids = {}
    for uid, e in pairs(egg_state) do
        local st = tostring(sf(e, "State") or "Slot")
        if st == "Slot" then
            local tier = egg_stats(e)
            local animal = tostring(sf(e, "AssetCategory") or "")
            local area = tostring(sf(e, "AreaId") or "")
            local mut = tostring(sf(e, "BaseMutation") or "None")
            if STATE.filterRarity == "All" or STATE.filterRarity == tier then
                if STATE.filterArea == "All" or STATE.filterArea == area then
                    if STATE.filterName == "All" or STATE.filterName == animal then
                        if STATE.filterMutation == "All" or STATE.filterMutation == mut then
                            uids[#uids+1] = uid
                        end
                    end
                end
            end
        end
    end
    table.sort(uids, function(a, b) return egg_income(egg_state[a]) > egg_income(egg_state[b]) end)
    return uids
end

