local function slot_free(wp, used)
    for _, p in ipairs(used) do if (p - wp).Magnitude < 2.2 then return false end end
    return true
end
local function pickBestUnplaced()
    local best
    for id, rec in pairs(saveData().EggInventory or {}) do
        if type(rec) == "table" and not isPlaced(id) then
            local cat = tostring(rec.AssetCategory or rec.Category or rec.Name or id)
            local rN, rName, earn = assetRarityOf(cat)
            local s = rN * 1e9 + mutationBonus(rec) + earn
            if not best or s > best.score then
                best = { uid=id, name=cat, rarity=rName, score=s }
