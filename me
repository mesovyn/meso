    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.Parent = row
    local state = default
    local function render(animate)
        local tw = animate and TweenInfo.new(0.18) or TweenInfo.new(0)
        if state then
            TweenService:Create(track, tw, {BackgroundColor3 = ACCENT}):Play()
            TweenService:Create(knob,  tw, {Position = UDim2.new(1, -18, 0.5, -8)}):Play()
        else
            TweenService:Create(track, tw, {BackgroundColor3 = STROKE}):Play()
            TweenService:Create(knob,  tw, {Position = UDim2.new(0, 2, 0.5, -8)}):Play()
        end
    end
    render(false)
    btn.MouseButton1Click:Connect(function()
        state = not state
        render(true)
        if onChanged then onChanged(state) end
    end)
    return { get = function() return state end }
